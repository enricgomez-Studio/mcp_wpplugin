da. Con llamadas, cartas y confianza fuimos construyendo relaciones sólidas con clientes, agencias, hoteles y tour-operadores, y abrimos camino con grupos internacionales hasta ser una de las agencias pioneras en traer grupos italianos a España.</p>","text_color":"#16436A","typography_typography":"custom","typography_font_family":"General Sans","typography_font_weight":"400","typography_font_size":{"unit":"px","size":18,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":16,"sizes":[]},"typography_line_height":{"unit":"em","size":1.5,"sizes":[]},"typography_letter_spacing":{"unit":"em","size":0.01,"sizes":[]}},"elements":[]},{"id":"e0f6258","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Foto del faro de Calella: <a href=\"https://commons.wikimedia.org/wiki/File:J21_096_Faro_de_Calella.jpg\" target=\"_blank\" rel=\"noopener\">Falk2</a>, <a href=\"https://creativecommons.org/licenses/by-sa/4.0/deed.es\" target=\"_blank\" rel=\"noopener\">CC BY-SA 4.0</a>.</p>","text_color":"rgba(18,26,26,0.55)","typography_typography":"custom","typography_font_family":"General Sans","typography_font_weight":"400","typography_font_size":{"unit":"px","size":13,"sizes":[]},"typography_line_height":{"unit":"em","size":1.4,"sizes":[]},"typography_letter_spacing":{"unit":"em","size":0.0,"sizes":[]},"custom_css":"selector a{color:inherit;text-decoration:underline}"},"elements":[]}]}]},{"id":"561b0bd","elType":"widget","widgetType":"image","settings":{"image":{"id":56,"url":"https://test-viajestauro.com.egserver.cloud/wp-content/uploads/2026/10/faro-de-calella-scaled.jpg"},"image_size":"1536x1536","width":{"unit":"%","size":100,"sizes":[]},"height":{"unit":"px","size":560,"sizes":[]},"height_tablet":{"unit":"px","size":460,"sizes":[]},"height_mobile":{"unit":"px","size":300,"sizes":[]},"object-fit":"cover","image_border_radius":{"unit":"px","top":"24","right":"24","bottom":"24","left":"24"},"_element_width":"initial","_element_custom_width":{"unit":"%","size":